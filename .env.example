# ==============================================================
# PILIHAN 1: MENGGUNAKAN LARAGON (MySQL / MariaDB bawaan)
# ==============================================================
# Di Laragon default user: root, password: (kosong), port: 3306
DATABASE_URL=mysql+pymysql://root:@localhost:3306/attendance_db

# ==============================================================
# PILIHAN 2: MENGGUNAKAN POSTGRESQL (Jika install PostgreSQL di Laragon/Docker)
# ==============================================================
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/attendance_db

# ==============================================================
# BACKEND API (FastAPI)
# ==============================================================
BACKEND_PORT=8000
STORAGE_DIR=storage

# Biometric AI Cosine Matching Threshold (distance <= 0.35 <=> similarity >= 65%)
MAX_COSINE_DISTANCE=0.35
FACE_SIMILARITY_THRESHOLD=0.65

# Optional: Path to custom ArcFace / InsightFace ONNX model
ARCFACE_MODEL_PATH=models/arcface_r50.onnx

# ==============================================================
# FRONTEND (Next.js)
# ==============================================================
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
